<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#4CAF50"
        android:padding="20dp"
        android:paddingTop="40dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ NÔNG SẢN HỮU CƠ"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rau sạch - Củ quả - Trái cây tươi"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:layout_gravity="center" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#4CAF50">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp">

            <Button
                android:id="@+id/btnAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="TẤT CẢ"
                android:textSize="11sp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#4CAF50" />

            <Button
                android:id="@+id/btnRecent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="7 NGÀY GẦN NHẤT"
                android:textSize="11sp"
                android:backgroundTint="#FFC107"
                android:textColor="#000000" />

            <Button
                android:id="@+id/btnRau"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="RAU"
                android:textSize="11sp"
                android:backgroundTint="#81C784"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnCu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="CỦ"
                android:textSize="11sp"
                android:backgroundTint="#81C784"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnTraiCay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="TRÁI CÂY"
                android:textSize="11sp"
                android:backgroundTint="#81C784"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnThem"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="+ THÊM NÔNG SẢN"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="15dp"
        android:background="#FFFFFF"
        android:divider="#EEEEEE"
        android:dividerHeight="1dp"
        android:padding="5dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nhấn giữ sản phẩm để Sửa/Xóa"
        android:textSize="12sp"
        android:textColor="#9E9E9E"
        android:gravity="center"
        android:padding="10dp" />

</LinearLayout>